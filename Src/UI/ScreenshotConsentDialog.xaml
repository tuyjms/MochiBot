<Window x:Class="MochiBot.Src.UI.ScreenshotConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图功能声明" Height="380" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="📸 截图功能声明" FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,12" HorizontalAlignment="Center"/>

        <!-- 声明内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="22">
                本应用提供视觉辅助功能，可以在特定时刻截取您的屏幕画面，用于帮助 AI 理解您当前的操作场景并提供更贴心的互动。
                <LineBreak/><LineBreak/>
                <Bold>📌 截图用途：</Bold>
                <LineBreak/>
                • 聊天时了解您正在做什么，提供更贴心的回复
                <LineBreak/>
                • 深夜关怀时判断您是否在工作，更好地关心您
                <LineBreak/>
                • 用眼提醒时了解您的用眼情况
                <LineBreak/><LineBreak/>
                <Bold>🔒 隐私保护：</Bold>
                <LineBreak/>
                • 截图仅用于即时分析，不会保存到磁盘
                <LineBreak/>
                • 截图内容不会进入聊天记录或记忆系统
                <LineBreak/>
                • 您可以随时在设置中关闭此功能
                <LineBreak/><LineBreak/>
                <Bold>⚙️ 控制权：</Bold>
                <LineBreak/>
                • 您可以单独控制每种场景的截图开关
                <LineBreak/>
                • 关闭后不会进行任何截图操作
            </TextBlock>
        </ScrollViewer>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="同意开启" Width="100" Height="32" Margin="0,0,12,0"
                    Click="ConsentButton_Click" IsDefault="True"/>
            <Button Content="暂不开启" Width="100" Height="32"
                    Click="DeclineButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
