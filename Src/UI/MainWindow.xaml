<Window x:Class="MochiBot.Src.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MochiBot"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <!-- 角色显示区域 - 填满整个窗口 -->
        <Image x:Name="characterImage" Stretch="Uniform" 
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- 气泡提示（浮在角色上方，可与角色重叠） -->
        <Border x:Name="chatBubble" 
                Background="#CCFFFFFF" 
                CornerRadius="12" 
                BorderBrush="#40000000" 
                BorderThickness="1"
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom" 
                Margin="10,0,10,60"
                MaxWidth="360"
                Visibility="Collapsed"
                MouseDown="Bubble_Click">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 小头像 -->
                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#FFE8D5C4"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="bubbleAvatarText" Text="小" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#FF8B6F5E"/>
                </Border>
                <!-- 消息预览 -->
                <TextBlock Grid.Column="1" x:Name="bubbleText" 
                           Text="" FontSize="13" Foreground="#FF333333"
                           TextWrapping="Wrap" MaxHeight="48"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 底部按钮区域 -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Margin="0,0,10,10">
            <!-- VRM 查看器按钮 -->
            <Border Width="36"
                    Height="36"
                    Margin="0,0,6,0"
                    CornerRadius="18"
                    Background="#CCFFFFFF">
                <Button x:Name="vrmViewerButton"
                        Content="🔮"
                        FontSize="16"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="VrmViewerButton_Click"/>
            </Border>
            <!-- 设置按钮 -->
            <Border Width="36"
                    Height="36"
                    Margin="0,0,6,0"
                    CornerRadius="18"
                    Background="#CCFFFFFF">
                <Button x:Name="settingsButton"
                        Content="⚙️"
                        FontSize="16"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SettingsButton_Click"/>
            </Border>
            <!-- 切换聊天按钮 -->
            <Border Width="36" 
                    Height="36"
                    CornerRadius="18"
                    Background="#CCFFFFFF">
                <Button x:Name="toggleChatButton" 
                        Content="💬" 
                        FontSize="18"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ToggleChatButton_Click"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
