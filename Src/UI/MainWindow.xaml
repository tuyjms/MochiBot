<Window x:Class="MochiBot.Src.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MochiBot"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        Topmost="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <!-- 渲染表面（占满整个窗口，代码中动态添加 Image 或 WebView2） -->
        <Grid x:Name="characterContainer">
            <!-- 聊天气泡 -->
            <Border x:Name="chatBubble"
                    CornerRadius="12"
                    Background="#CCFFFFFF"
                    Padding="8,6"
                    MaxWidth="220"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10,10,0,0"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    MouseDown="Bubble_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="12"
                            Background="#FF6B5CE7" Margin="0,0,8,0">
                        <TextBlock x:Name="bubbleAvatarText"
                                   Text="宠"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="bubbleText"
                               Text=""
                               Foreground="#FF333333"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="48"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部鼠标悬停检测区域（透明覆盖层，触发工具栏显示） -->
        <Border x:Name="toolbarHitZone"
                VerticalAlignment="Bottom"
                Height="60"
                Background="Transparent"
                MouseEnter="toolbarHitZone_MouseEnter"
                MouseLeave="toolbarHitZone_MouseLeave"/>

        <!-- 工具栏（悬停底部自动显示，浮在角色上方） -->
        <StackPanel x:Name="toolbarPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,10,10"
                    Visibility="Collapsed"
                    MouseEnter="toolbarPanel_MouseEnter"
                    MouseLeave="toolbarPanel_MouseLeave">
            <!-- 设置按钮 -->
            <Border Width="36" Height="36"
                    Margin="0,0,6,0"
                    CornerRadius="18"
                    Background="#CCFFFFFF">
                <Button ToolTip="设置"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SettingsButton_Click"
                        MouseEnter="IconBtn_MouseEnter"
                        MouseLeave="IconBtn_MouseLeave">
                    <Path x:Name="settingsIconPath"
                          Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                          Fill="#FF333333"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>
            </Border>
            <!-- 切换聊天按钮 -->
            <Border Width="36" Height="36"
                    CornerRadius="18"
                    Background="#CCFFFFFF">
                <Button ToolTip="聊天"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ToggleChatButton_Click"
                        MouseEnter="IconBtn_MouseEnter"
                        MouseLeave="IconBtn_MouseLeave">
                    <Path x:Name="chatIconPath"
                          Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z M20,16H5.17L4,17.17V4h16V16z"
                          Fill="#FF333333"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>
            </Border>
        </StackPanel>
    </Grid>
</Window>
