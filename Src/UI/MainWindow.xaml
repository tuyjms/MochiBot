<Window x:Class="MochiBot.Src.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MochiBot"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 桌宠展示区：WebView2 VRM 模型 -->
        <wv2:WebView2 Grid.Row="0" x:Name="webView"/>

        <!-- 底部按钮栏（右键切换显隐） -->
        <StackPanel Grid.Row="1" x:Name="buttonBar" Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
            <!-- 聊天按钮 -->
            <Border Width="44" Height="44" CornerRadius="22" Margin="8,0"
                    Background="#CCFFFFFF">
                <Button x:Name="chatButton" Content="💬" FontSize="18"
                        Background="Transparent" BorderThickness="0"
                        Click="ChatButton_Click"/>
            </Border>
            <!-- 互动按钮 -->
            <Border Width="44" Height="44" CornerRadius="22" Margin="8,0"
                    Background="#CCFFFFFF">
                <Button x:Name="interactButton" Content="🫳" FontSize="18"
                        Background="Transparent" BorderThickness="0"
                        Click="InteractButton_Click"/>
            </Border>
            <!-- 设置按钮 -->
            <Border Width="44" Height="44" CornerRadius="22" Margin="8,0"
                    Background="#CCFFFFFF">
                <Button x:Name="settingsButton" Content="⚙️" FontSize="18"
                        Background="Transparent" BorderThickness="0"
                        Click="SettingsButton_Click"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
