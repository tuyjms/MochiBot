<Window x:Class="MochiBot.Src.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MochiBot"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        Topmost="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <!-- 渲染表面（占满整个窗口，代码中动态添加 Image 或 WebView2） -->
        <Grid x:Name="characterContainer">
            <!-- 聊天气泡 -->
            <Border x:Name="chatBubble"
                    CornerRadius="12"
                    Background="#CCFFFFFF"
                    Padding="8,6"
                    MaxWidth="220"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10,10,0,0"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    MouseDown="Bubble_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="12"
                            Background="#FF6B5CE7" Margin="0,0,8,0">
                        <TextBlock x:Name="bubbleAvatarText"
                                   Text="宠"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="bubbleText"
                               Text=""
                               Foreground="#FF333333"
                               FontSize="13"
                               TextWrapping="Wrap"
                               MaxHeight="48"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部鼠标悬停检测区域（透明覆盖层，触发工具栏显示） -->
        <Border x:Name="toolbarHitZone"
                VerticalAlignment="Bottom"
                Height="60"
                Background="Transparent"
                MouseEnter="toolbarHitZone_MouseEnter"
                MouseLeave="toolbarHitZone_MouseLeave"/>

        <!-- 工具栏（悬停底部自动显示，浮在角色上方） -->
        <StackPanel x:Name="toolbarPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,10,10"
                    Visibility="Collapsed"
                    MouseEnter="toolbarPanel_MouseEnter"
                    MouseLeave="toolbarPanel_MouseLeave">
            <!-- 设置按钮 -->
            <Border Width="36" Height="36"
                    Margin="0,0,6,0"
                    CornerRadius="18"
                    Background="#CCFFFFFF">
                <Button Content="⚙️"
                        FontSize="16"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SettingsButton_Click"/>
            </Border>
            <!-- 切换聊天按钮 -->
            <Border Width="36" Height="36"
                    CornerRadius="18"
                    Background="#CCFFFFFF">
                <Button Content="💬"
                        FontSize="18"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ToggleChatButton_Click"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
