<Window x:Class="MochiBot.Src.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="520" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="tabControl">
            <!-- Tab 1: 基础设置 -->
            <TabItem Header="基础设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <!-- 用户名称 -->
                        <Label Content="用户名称" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBox x:Name="userNameBox" Height="30" FontSize="14" Padding="6,0" Margin="0,0,0,10"/>

                        <!-- 激活人格 -->
                        <Label Content="激活人格" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <ComboBox x:Name="activePersonalityBox" Height="30" FontSize="14" Margin="0,0,0,10"/>

                        <!-- 碎碎念设置 -->
                        <Label Content="碎碎念" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="murmurEnabledCheck" Content="启用"
                                      VerticalAlignment="Center" FontSize="13" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="间隔（分钟）" VerticalAlignment="Center" FontSize="13" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="3" x:Name="murmurIntervalBox" Width="60" Height="28"
                                     FontSize="13" TextAlignment="Center" Padding="4,0"/>
                        </Grid>

                        <!-- LLM 行为 -->
                        <Label Content="LLM 行为" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,2"/>
                        <CheckBox x:Name="structuredResponseCheck" Content="启用结构化响应" FontSize="13" Margin="0,2"/>
                        <CheckBox x:Name="midTermMemoryOnChatCheck" Content="对话时主动录入中期记忆" FontSize="13" Margin="0,2"/>
                        <CheckBox x:Name="longTermRecallCheck" Content="对话时检索长期记忆" FontSize="13" Margin="0,2"/>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="单次最大动作数" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="maxActionsBox" Height="28" FontSize="13"
                                     TextAlignment="Center" Padding="4,0"/>
                        </Grid>

                        <!-- 关闭行为 -->
                        <Label Content="关闭窗口行为" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,2"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="关闭主窗口时" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" x:Name="closeBehaviorBox" Height="28" FontSize="13"/>
                        </Grid>

                        <!-- 桌宠窗口设置 -->
                        <Label Content="桌宠窗口" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,2"/>
                        <CheckBox x:Name="passthroughCheck" Content="启用鼠标穿透" FontSize="13" Margin="0,2,0,6"
                                  Checked="PassthroughCheck_Changed" Unchecked="PassthroughCheck_Changed"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="穿透模式透明度" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                            <Slider Grid.Column="0" x:Name="passthroughOpacitySlider" Minimum="0.1" Maximum="1.0" Value="0.3"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="120,0,50,0"/>
                            <TextBlock Grid.Column="1" x:Name="passthroughOpacityValue" Text="0.3"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13"/>
                        </Grid>

                        <!-- 日志设置 -->
                        <Label Content="日志" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日志级别" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" x:Name="logLevelBox" Height="28" FontSize="13"/>
                        </Grid>
                        <CheckBox x:Name="logToFileCheck" Content="输出日志到文件" FontSize="13" Margin="0,2"/>
                        <CheckBox x:Name="logToConsoleCheck" Content="输出日志到控制台" FontSize="13" Margin="0,2,0,10"/>

                        <!-- 视觉功能 -->
                        <Label Content="视觉功能" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,2"/>
                        <CheckBox x:Name="autoScreenshotOnChatCheck" Content="聊天时自动截图" FontSize="13" Margin="0,2"/>
                        <CheckBox x:Name="screenshotOnLateNightCheck" Content="深夜关怀时截图" FontSize="13" Margin="0,2"/>
                        <CheckBox x:Name="screenshotOnEyeRestCheck" Content="用眼提醒时截图" FontSize="13" Margin="0,2,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: LLM 提供商 -->
            <TabItem Header="LLM 提供商">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel x:Name="providersPanel"/>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: 人格编辑 -->
            <TabItem Header="人格编辑">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <!-- 人格选择 -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="选择人格" FontSize="13" FontWeight="SemiBold" Padding="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="+" Width="28" Height="26" FontSize="14" FontWeight="Bold"
                                        Click="AddPersonality_Click" Margin="0,0,4,0"/>
                                <Button Content="-" Width="28" Height="26" FontSize="14" FontWeight="Bold"
                                        Click="RemovePersonality_Click"/>
                            </StackPanel>
                        </Grid>
                        <ComboBox x:Name="personalitySelector" Height="30" FontSize="14" Margin="0,0,0,10"
                                  SelectionChanged="PersonalitySelector_Changed"/>

                        <!-- 名称 -->
                        <Label Content="名称" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBox x:Name="personNameBox" Height="30" FontSize="14" Padding="6,0" Margin="0,0,0,10"/>

                        <!-- 显示模式 -->
                        <Label Content="显示模式" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <ComboBox x:Name="displayModeBox" Height="30" FontSize="14" Margin="0,0,0,10">
                            <ComboBoxItem Content="GIF 动图" Tag="Gif"/>
                            <ComboBoxItem Content="VRM 3D" Tag="Vrm"/>
                        </ComboBox>

                        <!-- 描述 -->
                        <Label Content="人格描述" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBox x:Name="personDescBox" FontSize="13" Padding="6,4" Margin="0,0,0,10"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto"/>

                        <!-- 聊天模型 -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="聊天模型" FontSize="13" FontWeight="SemiBold" Padding="0"/>
                            <Button Grid.Column="1" Content="-" Width="28" Height="26" FontSize="14" FontWeight="Bold"
                                    Click="RemoveChatModel_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="modelProviderBox" Grid.Column="0" Width="110" FontSize="13" Margin="0,0,4,0"
                                      SelectionChanged="ModelProviderBox_Changed"/>
                            <ComboBox x:Name="modelNameBox" Grid.Column="1" FontSize="13" Margin="0,0,4,0"
                                      IsEditable="True"/>
                            <Button Grid.Column="4" Content="+" Width="28" Height="26" FontSize="14" FontWeight="Bold"
                                    Click="AddChatModel_Click"/>
                        </Grid>
                        <ListBox x:Name="chatModelsList" Height="70" Margin="0,0,0,10" FontSize="13"/>

                        <!-- 子人格 -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="子人格" FontSize="13" FontWeight="SemiBold" Padding="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="+" Width="28" Height="26" FontSize="14" FontWeight="Bold"
                                        Click="AddSubPersonality_Click" Margin="0,0,4,0"/>
                                <Button Content="-" Width="28" Height="26" FontSize="14" FontWeight="Bold"
                                        Click="RemoveSubPersonality_Click"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid x:Name="subPersonalitiesGrid" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  MinHeight="100" MaxHeight="200" FontSize="13"
                                  SelectionMode="Single" Margin="0,0,0,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="描述" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                <DataGridTextColumn Header="权重" Binding="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="weightSumLabel" Text="权重总和: 100" FontSize="12" Foreground="Gray" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: 模块参数 -->
            <TabItem Header="模块参数">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <!-- 短期记忆 -->
                        <Expander Header="短期记忆" IsExpanded="True" Margin="0,0,0,6">
                            <StackPanel Margin="16,4,0,4">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="容量" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" x:Name="stCapacityBox" Height="26" FontSize="13" TextAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="修剪阈值" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" x:Name="stTrimThresholdBox" Height="26" FontSize="13" TextAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="溢出策略" VerticalAlignment="Center" FontSize="13"/>
                                    <ComboBox Grid.Column="1" x:Name="stOverflowStrategyBox" Height="26" FontSize="13"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="摘要保留数" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" x:Name="stSummaryReservedBox" Height="26" FontSize="13" TextAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- 中期记忆 -->
                        <Expander Header="中期记忆" Margin="0,0,0,6">
                            <StackPanel Margin="16,4,0,4">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="最大条目" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" x:Name="mtMaxEntriesBox" Height="26" FontSize="13" TextAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="重要性阈值" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" x:Name="mtImportanceThresholdBox" Height="26" FontSize="13" TextAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="溢出采样率" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" x:Name="mtOverflowSampleRateBox" Height="26" FontSize="13" TextAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="关键词扫描间隔" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" x:Name="mtKeywordScanIntervalBox" Height="26" FontSize="13" TextAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="热门关键词数" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" x:Name="mtTopKeywordsCountBox" Height="26" FontSize="13" TextAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- 长期记忆 -->
                        <Expander Header="长期记忆" Margin="0,0,0,6">
                            <StackPanel Margin="16,4,0,4">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="晋升间隔(天)" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" x:Name="ltPromotionIntervalBox" Height="26" FontSize="13" TextAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="晋升阈值" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" x:Name="ltPromotionThresholdBox" Height="26" FontSize="13" TextAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="即时阈值" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" x:Name="ltImmediateThresholdBox" Height="26" FontSize="13" TextAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="最大条目" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" x:Name="ltMaxEntriesBox" Height="26" FontSize="13" TextAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="搜索返回数" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" x:Name="ltSearchTopNBox" Height="26" FontSize="13" TextAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="退出桌宠" Width="80" Height="32" FontSize="13"
                    HorizontalAlignment="Left" Foreground="#FFD32F2F"
                    Click="ExitButton_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="保存" Width="80" Height="32" FontSize="13"
                        Click="SaveButton_Click" Margin="0,0,8,0"/>
                <Button Content="取消" Width="80" Height="32" FontSize="13"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
