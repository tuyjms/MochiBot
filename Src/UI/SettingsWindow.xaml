<Window x:Class="MochiBot.Src.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="400" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 用户名称 -->
        <Label Grid.Row="0" Content="用户名称" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <TextBox Grid.Row="1" x:Name="userNameBox" Height="30" FontSize="14" Padding="6,0" Margin="0,0,0,12"/>

        <!-- 窗口透明度 -->
        <Label Grid.Row="2" Content="窗口透明度" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Slider Grid.Column="0" x:Name="opacitySlider" Minimum="0.2" Maximum="1.0" Value="1.0" 
                    TickFrequency="0.1" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" x:Name="opacityValue" Text="1.0" 
                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13"/>
        </Grid>

        <!-- 碎碎念设置 -->
        <Label Grid.Row="4" Content="碎碎念" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" x:Name="murmurEnabledCheck" Content="启用" 
                      VerticalAlignment="Center" FontSize="13" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="2" Text="间隔（分钟）" VerticalAlignment="Center" FontSize="13" Margin="0,0,6,0"/>
            <TextBox Grid.Column="3" x:Name="murmurIntervalBox" Width="60" Height="28" 
                     FontSize="13" TextAlignment="Center" Padding="4,0"/>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Width="80" Height="32" FontSize="13" 
                    Click="SaveButton_Click" Margin="0,0,8,0"/>
            <Button Content="取消" Width="80" Height="32" FontSize="13" 
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
